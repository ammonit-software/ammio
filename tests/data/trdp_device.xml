<?xml version="1.0" encoding="UTF-8"?>
<!-- Device configuration of a (fictitious) door controller, used by the XML import unit test -->
<device xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="trdp-config.xsd"
        host-name="doorctrl" type="DCU">
    <device-configuration memory-size="65535"/>
    <bus-interface-list>
        <bus-interface network-id="1" name="eth0" host-ip="10.0.0.5">
            <trdp-process blocking="no" cycle-time="10000" priority="80" traffic-shaping="on"/>
            <pd-com-parameter marshall="off" port="17224" qos="5" ttl="64" timeout-value="100000" validity-behavior="zero"/>
            <md-com-parameter udp-port="17225" tcp-port="17225" confirm-timeout="1000000" connect-timeout="60000000"
                              reply-timeout="5000000" marshall="off" protocol="UDP" qos="3" retries="2" ttl="64"/>
            <!-- Published by the door controller: an SUT output for ammio -->
            <telegram name="DoorStatus" com-id="3001" data-set-id="3001" com-parameter-id="1" type="source">
                <pd-parameter cycle="100000" timeout="300000" validity-behavior="keep"/>
                <source id="1" uri1="10.0.0.5"/>
                <destination id="1" uri="239.10.0.1"/>
            </telegram>
            <!-- Received by the door controller: an SUT input that ammio publishes -->
            <telegram name="DoorCommand" com-id="3002" data-set-id="3002" com-parameter-id="1" type="sink">
                <pd-parameter cycle="50000" timeout="150000" validity-behavior="zero"/>
                <source id="1" uri1="10.0.0.1"/>
                <destination id="1" uri="239.10.0.2"/>
            </telegram>
            <!-- No type attribute: direction inferred from the source (the device itself) -->
            <telegram name="Diag" com-id="3003" data-set-id="3003" com-parameter-id="1">
                <pd-parameter cycle="1000000" timeout="3000000"/>
                <source id="1" uri1="10.0.0.5"/>
                <destination id="1" uri="10.0.0.1"/>
            </telegram>
        </bus-interface>
    </bus-interface-list>
    <com-parameter-list>
        <com-parameter id="1" qos="5" ttl="64"/>
    </com-parameter-list>
    <data-set-list>
        <data-set name="Leaf" id="3100">
            <element name="open" type="BOOL8"/>
            <element name="force" type="INT16"/>
        </data-set>
        <data-set name="DoorStatus" id="3001">
            <element name="lifeSign" type="UINT16"/>
            <element name="door" type="3100" array-size="2"/>
            <element name="speed" type="REAL32"/>
            <element name="since" type="TIMEDATE64"/>
        </data-set>
        <data-set name="DoorCommand" id="3002">
            <element name="cmd" type="UINT8"/>
            <element name="text" type="CHAR8" array-size="3"/>
            <element name="counter" type="UINT64"/>
        </data-set>
        <data-set name="Diag" id="3003">
            <element name="errors" type="UINT32"/>
            <element name="t48" type="TIMEDATE48"/>
        </data-set>
    </data-set-list>
</device>
