{
    "scada_server": {
        "protocol": "opcua",
        "settings": {
            "endpoint": "opc.tcp://192.168.1.20:4840",
            "username": "operator",
            "password": "password",
            "period_ms": 100,
            "timeout_ms": 5000,
            "read_mode": "subscription",
            "write_mode": "on_change",
            "nodes": {
                "inputs": [
                    { "var_id": "motor_speed_actual", "node_id": "ns=1;s=Motor.SpeedActual", "type": "float32" },
                    { "var_id": "motor_fault_code",   "node_id": "ns=1;i=1010",              "type": "uint16" }
                ],
                "outputs": [
                    { "var_id": "motor_speed_setpoint", "node_id": "ns=1;s=Motor.SpeedSetpoint", "type": "float32" },
                    { "var_id": "motor_enable",         "node_id": "ns=1;i=1001",                "type": "bool" }
                ]
            }
        }
    }
}
